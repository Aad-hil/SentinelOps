# Application
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL
# SentinelOps can reuse an existing local PostgreSQL container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinelops
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=sentinelops_knowledge
QDRANT_INCIDENT_COLLECTION=sentinelops_incidents

# AWS Bedrock Embeddings
AWS_REGION=ap-south-1
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024
BEDROCK_EMBEDDING_NORMALIZE=true

# LLM / Generation
OPENAI_API_KEY=

# LangSmith
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=sentinelops
# OpenTelemetry
# Leave empty for no remote exporter. For local Jaeger stack use: http://localhost:4317
SENTINELOPS_OTEL_EXPORTER_OTLP_ENDPOINT=
SENTINELOPS_OTEL_CONSOLE=false
